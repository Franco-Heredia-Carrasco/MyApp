<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    xmlns:tools="http://android.com"
    xmlns:tools2="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        tools2:ignore="MissingConstraints"
        tools2:layout_editor_absoluteX="0dp"
        tools2:layout_editor_absoluteY="7dp">


        <TextView
            android:id="@+id/txtTituloPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/TXT_Guías_de_supervivencia"
            android:textAlignment="center"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/boton_Terremotos"
            android:layout_width="172dp"
            android:layout_height="85dp"
            android:layout_gravity="start"
            android:text="@string/Txt_Terremotos" />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
