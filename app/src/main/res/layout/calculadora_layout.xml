<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <Space
        android:id="@+id/space"
        android:layout_width="403dp"
        android:layout_height="190dp"
        android:layout_marginTop="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <LinearLayout
        android:id="@+id/fila_funciones"
        android:layout_width="320dp"
        android:layout_height="78dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.087"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space"
        app:layout_constraintVertical_bias="0.033">

        <Button
            android:id="@+id/button_ac"
            android:layout_width="96dp"
            android:layout_height="78dp"
            android:layout_marginEnd="4dp"
            android:text="@string/boton_ac"
            android:textSize="24sp" />


    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila_superior"
        android:layout_width="320dp"
        android:layout_height="86dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.087"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fila_funciones"
        app:layout_constraintVertical_bias="0.034">

        <Button
            android:id="@+id/button_7"
            android:layout_width="96dp"
            android:layout_height="78dp"
            android:layout_marginEnd="4dp"
            android:text="@string/boton_7"
            android:textSize="24sp" />

        <Button
            android:id="@+id/button_8"
            android:layout_width="96dp"
            android:layout_height="78dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="@string/boton_8"
            android:textSize="24sp" />

        <Button
            android:id="@+id/button_9"
            android:layout_width="96dp"
            android:layout_height="78dp"
            android:layout_marginStart="4dp"
            android:text="@string/boton_9"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila_inferior"
        android:layout_width="320dp"
        android:layout_height="78dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.087"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fila_central"
        app:layout_constraintVertical_bias="0.077">

        <Button
            android:id="@+id/button_1"
            android:layout_width="96dp"
            android:layout_height="78dp"
            android:layout_marginEnd="4dp"
            android:text="@string/boton_1"
            android:textSize="24sp" />

        <Button
            android:id="@+id/button_2"
            android:layout_width="96dp"
            android:layout_height="78dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="@string/boton_2"
            android:textSize="24sp" />

        <Button
            android:id="@+id/button_3"
            android:layout_width="96dp"
            android:layout_height="78dp"
            android:layout_marginStart="4dp"
            android:text="@string/boton_3"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila_central"
        android:layout_width="320dp"
        android:layout_height="86dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.087"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fila_superior"
        app:layout_constraintVertical_bias="0.037">

        <Button
            android:id="@+id/button_4"
            android:layout_width="96dp"
            android:layout_height="78dp"
            android:layout_marginEnd="4dp"
            android:text="@string/boton_4"
            android:textSize="24sp" />

        <Button
            android:id="@+id/button_5"
            android:layout_width="96dp"
            android:layout_height="78dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="@string/boton_5"
            android:textSize="24sp" />

        <Button
            android:id="@+id/button_6"
            android:layout_width="96dp"
            android:layout_height="78dp"
            android:layout_marginStart="4dp"
            android:text="@string/boton_6"
            android:textSize="24sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila_de_ceros"
        android:layout_width="320dp"
        android:layout_height="78dp"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.087"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fila_inferior"
        app:layout_constraintVertical_bias="0.171">

        <Button
            android:id="@+id/button_del_num_act"
            android:layout_width="96dp"
            android:layout_height="78dp"
            android:layout_marginEnd="4dp"
            android:text="@string/boton_c"
            android:textSize="24sp" />

        <Button
            android:id="@+id/button_0"
            android:layout_width="96dp"
            android:layout_height="78dp"
            android:layout_marginEnd="4dp"
            android:text="@string/boton_0"
            android:textSize="24sp" />

        <Button
            android:id="@+id/button_punto"
            android:layout_width="96dp"
            android:layout_height="78dp"
            android:layout_marginStart="4dp"
            android:text="@string/boton_."
            android:textSize="30sp" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>